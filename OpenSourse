local function hookChar(char)
    local h = char:WaitForChild("Humanoid", 10)
    local r = char:WaitForChild("HumanoidRootPart", 10)
    if not h or not r then return end
    local target = (opt.rs_cp and checkpoint) or pendingCF
    pendingCF = nil
    if target then
        task.wait(opt.rs_delay or .1)
        for _ = 1, 3 do
            if r.Parent then r.CFrame = target r.AssemblyLinearVelocity = Vector3.zero end
            run.Heartbeat:Wait()
        end
    end
    if opt.cam_offset and opt.cam_offset ~= 0 then h.CameraOffset = Vector3.new(0, opt.cam_offset, 0) end
    local fired = false
    local function died()
        if fired then return end
        fired = true
        if r.Parent then deathCF = r.CFrame end
        if opt.rs_return or opt.rs_cp then pendingCF = deathCF end
        if opt.rs_instant then forceRespawn() end
    end
    h.Died:Connect(died)
    h.HealthChanged:Connect(function(v) if v <= 0 then died() end end)
end

local function mkEff(class, name)
    local e = light:FindFirstChild(name)
    if not e then e = Instance.new(class) e.Name = name e.Enabled = false e.Parent = light end
    return e
end
