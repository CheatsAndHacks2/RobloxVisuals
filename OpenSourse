local weather = {}
local function setWeather(kind)
    if weather.part then weather.part:Destroy() weather.part = nil weather.em = nil end
    if kind == "Нет" then return end
    local p = Instance.new("Part") p.Name = "DH_Weather" p.Anchored = true p.CanCollide = false p.CanQuery = false p.CanTouch = false
    p.Transparency = 1 p.Size = Vector3.new(80, 1, 80) p.Parent = cam()
    local e = Instance.new("ParticleEmitter") e.Name = "DH_Weather" e.EmissionDirection = Enum.NormalId.Bottom e.LockedToPart = false
    e.Rotation = NumberRange.new(0, 360) e.Parent = p
    if kind == "Снег" then
        e.Lifetime = NumberRange.new(5, 7) e.Speed = NumberRange.new(6, 10) e.Size = NumberSequence.new(.3) e.Transparency = NumberSequence.new(.2)
        e.Color = ColorSequence.new(Color3.new(1, 1, 1)) e.Acceleration = Vector3.new(3, 0, 1) e.LightEmission = .6 e.SpreadAngle = Vector2.new(15, 15)
    elseif kind == "Дождь" then
        e.Lifetime = NumberRange.new(.5, .7) e.Speed = NumberRange.new(90, 110) e.Size = NumberSequence.new(.5) e.Transparency = NumberSequence.new(.5)
        e.Color = ColorSequence.new(Color3.fromRGB(170, 200, 255)) e.Orientation = Enum.ParticleOrientation.VelocityParallel e.SpreadAngle = Vector2.new(3, 3)
    else
        e.Lifetime = NumberRange.new(4, 6) e.Speed = NumberRange.new(2, 5) e.Size = NumberSequence.new(.25) e.LightEmission = 1
        e.Color = ColorSequence.new(Color3.fromRGB(255, 210, 90)) e.Acceleration = Vector3.new(0, -1, 0) e.SpreadAngle = Vector2.new(40, 40)
    end
    e.Rate = (opt.world_wint or 50) * 5
    weather.part, weather.em = p, e
end

