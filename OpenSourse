local function on(sig, fn) local c = sig:Connect(fn) conns[#conns + 1] = c return c end
local function safe(f, ...) if f then local ok, e = pcall(f, ...) if not ok then warn("[DoctorHack] " .. tostring(e)) end end end

local function apply(g, inst, prop, val)
    pcall(function()
        local t = groups[g]
        if not t then t = setmetatable({}, { __mode = "k" }) groups[g] = t end
        t[inst] = t[inst] or {}
        if t[inst][prop] == nil then t[inst][prop] = inst[prop] end
        inst[prop] = val
    end)
end
local function revert(g)
    local t = groups[g]
    if not t then return end
    for inst, props in pairs(t) do
        for p, v in pairs(props) do pcall(function() inst[p] = v end) end
    end
    groups[g] = nil
end

local function unwatch(n) if watchers[n] then watchers[n]:Disconnect() watchers[n] = nil end end
local function watch(n, root, pred, fn)
    unwatch(n)
    task.spawn(function()
        local c = 0
        for _, d in ipairs(root:GetDescendants()) do
            if pred(d) then fn(d) end
            c += 1
            if c % 300 == 0 then task.wait() end
        end
    end)
    watchers[n] = root.DescendantAdded:Connect(function(d) if pred(d) then task.defer(fn, d) end end)
end
