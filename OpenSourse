    local function set(x, silent)
        opt[id] = x v.Text = tostring(x) mark()
        if cb and not silent then safe(cb, x) end
    end
    local function resize() twn(r, .25, { Size = UDim2.new(1, 0, 0, open and (48 + #opts * 28) or 40) }) twn(arrow, .25, { Rotation = open and 180 or 0 }) end
    local function build()
