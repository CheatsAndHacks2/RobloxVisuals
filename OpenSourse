local function accent(inst, prop) accentObjs[#accentObjs + 1] = { inst, prop } inst[prop] = theme.accent end
local function setAccent(c)
    theme.accent = c
    for i = #accentObjs, 1, -1 do
        local a = accentObjs[i]
