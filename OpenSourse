function aura.build()
    aura.clear()
    local root = hrp()
    if not opt.aura_on or not root then return end
    local char = lp.Character
    local folder = Instance.new("Folder") folder.Name = "DH_Aura" folder.Parent = cam() aura.folder = folder
    local style, size, count = opt.aura_style, opt.aura_size, opt.aura_count
    local att = keepExtra(Instance.new("Attachment")) att.Name = "DH_Att" att.Parent = root
    local tr = opt.aura_transp / 100

    if style == "Частицы" then
        local e = Instance.new("ParticleEmitter") e.Name = "DH_Emitter"
        e.Rate = count * 4 e.Lifetime = NumberRange.new(1, 2) e.Speed = NumberRange.new(size * .15, size * .4)
        e.SpreadAngle = Vector2.new(180, 180) e.LightEmission = 1 e.LockedToPart = false e.Acceleration = Vector3.new(0, 2, 0)
        e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size * .08), NumberSequenceKeypoint.new(1, 0) })
        e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, tr), NumberSequenceKeypoint.new(1, 1) })
        e.Rotation = NumberRange.new(0, 360) e.Color = ColorSequence.new(auraCol(0))
        pcall(function() e.Shape = Enum.ParticleEmitterShape.Sphere end)
        e.Parent = att aura.emitter = e
    elseif style == "Пламя" then
        local f = keepExtra(Instance.new("Fire")) f.Name = "DH_Fire" f.Size = math.clamp(size * 1.4, 2, 30) f.Heat = 8
        f.Color = auraCol(0) f.SecondaryColor = auraCol(3) f.Parent = root aura.fire = f
    elseif style == "Сияние" then
        local s = keepExtra(Instance.new("Sparkles")) s.Name = "DH_Sparkles" s.SparkleColor = auraCol(0) s.Parent = root aura.sparkles = s
    elseif style == "Орбиты" or style == "Спираль" then
        local n = math.clamp(count, 2, 24)
        for i = 1, n do
            local p = newPart(Vector3.new(1, 1, 1) * (.35 + size / 14)) p.Shape = Enum.PartType.Ball p.Name = "DH_Orb" p.Transparency = tr p.Parent = folder
            if opt.aura_trail then
                local a0 = Instance.new("Attachment", p) a0.Position = Vector3.new(0, .2, 0)
                local a1 = Instance.new("Attachment", p) a1.Position = Vector3.new(0, -.2, 0)
                local t = Instance.new("Trail") t.Name = "DH_Trail" t.Attachment0 = a0 t.Attachment1 = a1 t.Lifetime = .7 t.LightEmission = 1
                t.Transparency = NumberSequence.new(.2, 1) t.Parent = p
            end
            aura.orbs[i] = p
        end
    elseif style == "Кольца" then
        for k = 1, 3 do
            local p, st = mkRing(size * (2.5 - k * .35), folder)
            aura.rings[#aura.rings + 1] = { part = p, strokes = st, kind = "ring", i = k }
        end
    elseif style == "Нимб" then
        local p, st = mkRing(math.max(1.5, size * .3), folder)
        aura.rings[#aura.rings + 1] = { part = p, strokes = st, kind = "halo", i = 1 }
    end
    if opt.aura_ground then
        local p, st = mkRing(size * 2, folder)
        aura.rings[#aura.rings + 1] = { part = p, strokes = st, kind = "ground", i = 5 }
    end
    if opt.aura_glow then
        local l = keepExtra(Instance.new("PointLight")) l.Name = "DH_Light" l.Brightness = opt.aura_glow_b l.Range = 18 l.Color = auraCol(0) l.Parent = root aura.light = l
    end
    if opt.aura_hl then
        local h = keepExtra(Instance.new("Highlight")) h.Name = "DH_HL" h.Adornee = char h.FillColor = auraCol(0) h.OutlineColor = Color3.new(1, 1, 1)
        h.FillTransparency = opt.aura_hl_t / 100 h.DepthMode = Enum.HighlightDepthMode.Occluded h.Parent = folder aura.hl = h
    else aura.hl = nil end
    if opt.aura_neon and char then
        for _, d in ipairs(char:GetDescendants()) do if d:IsA("BasePart") then apply("neon", d, "Material", Enum.Material.Neon) end end
    end
end
function aura.rebuild() dirty = true end

function aura.step(dt)
    local root = hrp() if not root then return end
    aura.t += dt * opt.aura_speed
    local t, pos, n = aura.t, root.Position, #aura.orbs
    for i, o in ipairs(aura.orbs) do
        local a, r, y = t * 2 + (i / n) * math.pi * 2, opt.aura_size, 0
        if opt.aura_style == "Спираль" then y = (((t * .25) + i / n) % 1) * r * 2 - r a = t * 3 + i * .9 r = r * .7 end
        o.CFrame = CFrame.new(pos + Vector3.new(math.cos(a) * r, y, math.sin(a) * r))
        o.Color = auraCol(i)
    end
    for _, r in ipairs(aura.rings) do
        local cf
        if r.kind == "ring" then
            local k = r.i cf = CFrame.new(pos) * CFrame.Angles(t * (.6 + k * .3) + k, t * (.5 - k * .15), t * .4 * k)
        elseif r.kind == "halo" then
            cf = CFrame.new(pos + Vector3.new(0, 3.1 + math.sin(t * 2) * .1, 0)) * CFrame.Angles(math.sin(t) * .08, t, math.cos(t) * .08)
        else
            local h = hum() local drop = 3
            if h and h.RigType == Enum.HumanoidRigType.R15 then drop = h.HipHeight + root.Size.Y / 2 end
            cf = CFrame.new(pos - Vector3.new(0, drop - .1, 0)) * CFrame.Angles(0, t, 0)
        end
        r.part.CFrame = cf
        local c = auraCol(r.i)
        for _, s in ipairs(r.strokes) do s.Color = c end
    end
    if opt.aura_rainbow then
        local c = auraCol(0)
        if aura.emitter then aura.emitter.Color = ColorSequence.new(c) end
        if aura.light then aura.light.Color = c end
        if aura.fire then aura.fire.Color = c aura.fire.SecondaryColor = auraCol(3) end
        if aura.sparkles then aura.sparkles.SparkleColor = c end
        if aura.hl then aura.hl.FillColor = c end
    end
end

