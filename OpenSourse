    local v = txt(r, "", 13, theme.sub, Enum.TextXAlignment.Right) v.Position = UDim2.new(1, -94, 0, 7) v.Size = UDim2.fromOffset(80, 18)
    local track = mk("Frame", { Size = UDim2.new(1, -28, 0, 6), Position = UDim2.fromOffset(14, 37), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = .85, Parent = r }) round(track, 3)
    local fill = mk("Frame", { Size = UDim2.fromScale(0, 1), BorderSizePixel = 0, Parent = track }) round(fill, 3) accent(fill, "BackgroundColor3")
    local kn = mk("Frame", { Size = UDim2.fromOffset(16, 16), AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(0, .5), BackgroundColor3 = Color3.new(1, 1, 1), Parent = track }) round(kn, 8)
    local hit = mk("TextButton", { Size = UDim2.new(1, -16, 0, 26), Position = UDim2.fromOffset(8, 27), BackgroundTransparency = 1, Text = "", Parent = r })
    local function set(x, silent)
        x = math.clamp(tonumber(x) or def, min, max)
        x = math.floor(x / step + .5) * step
        x = tonumber(string.format("%.4f", x))
        opt[id] = x v.Text = tostring(x) .. (suffix or "")
        local a = (x - min) / (max - min)
        fill.Size = UDim2.fromScale(a, 1) kn.Position = UDim2.fromScale(a, .5)
        if cb and not silent then safe(cb, x) end
    end
    local function fromX(px) set(min + math.clamp((px - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1) * (max - min)) end
    hit.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            activeSlider = fromX fromX(i.Position.X)
        end
    end)
    reg(id, set, def) set(def, true)
    return { Set = set }
end

