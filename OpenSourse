local function mkRing(d, parent)
    local p = newPart(Vector3.new(d, .05, d)) p.Transparency = 1 p.Parent = parent
    local strokes = {}
    for _, face in ipairs({ Enum.NormalId.Top, Enum.NormalId.Bottom }) do
        local sg = Instance.new("SurfaceGui") sg.Face = face sg.LightInfluence = 0 sg.AlwaysOnTop = false
        sg.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize sg.CanvasSize = Vector2.new(256, 256) sg.Adornee = p sg.Parent = p
        local f = Instance.new("Frame") f.Size = UDim2.fromScale(1, 1) f.BackgroundTransparency = 1 f.Parent = sg
        local c = Instance.new("UICorner") c.CornerRadius = UDim.new(.5, 0) c.Parent = f
        local s = Instance.new("UIStroke") s.Thickness = 9 s.Transparency = opt.aura_transp / 100 s.Parent = f
        strokes[#strokes + 1] = s
