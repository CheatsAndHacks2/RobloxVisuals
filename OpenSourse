local acc, frames, fpsVal, audioAcc = 0, 0, 60, 0
on(run.Heartbeat, function(dt)
    if dirty and os.clock() - lastBuild > .12 then dirty = false lastBuild = os.clock() aura.build() end
    if opt.aura_on then aura.step(dt) end
    if weather.part then weather.part.CFrame = CFrame.new(cam().CFrame.Position + Vector3.new(0, 35, 0)) end
    frames += 1 acc += dt audioAcc += dt
    if acc >= .5 then
        fpsVal = math.floor(frames / acc + .5) frames = 0 acc = 0
        local lines = {}
        if opt.hud_fps then lines[#lines + 1] = "FPS  " .. fpsVal end
        if opt.hud_ping then
            local ok, p = pcall(function() return stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
            lines[#lines + 1] = "Ping  " .. (ok and math.floor(p) or "?") .. " мс"
        end
        if opt.hud_mem then lines[#lines + 1] = "RAM  " .. math.floor(stats:GetTotalMemoryUsageMb()) .. " MB" end
        if opt.hud_time then lines[#lines + 1] = "Сессия  " .. fmt(os.clock() - sessionStart) end
        if opt.hud_pos then
            local r = hrp()
            if r then local p = r.Position lines[#lines + 1] = string.format("XYZ  %d, %d, %d", p.X, p.Y, p.Z) end
        end
        hud.Visible = #lines > 0 hud.Text = table.concat(lines, "\n")
        if opt.rs_auto then
            local h, r = hum(), hrp()
            if h and r and h.Health > 0 and h.FloorMaterial ~= Enum.Material.Air then
                cpT = (cpT or 0) + .5
                if cpT >= 3 then cpT = 0 checkpoint = r.CFrame end
            end
        end
        if vwin.Visible then
            vfill.Size = UDim2.fromScale(vframe.TimeLength > 0 and (vframe.TimePosition / vframe.TimeLength) or 0, 1)
            vtime.Text = fmt(vframe.TimePosition) .. " / " .. fmt(vframe.TimeLength)
        end
        if isOpen then
            serverLbl:Set(string.format("Игроков на сервере: <b>%d</b>  •  PlaceId: <b>%d</b>  •  FPS: <b>%d</b>", #players:GetPlayers(), game.PlaceId, fpsVal))
        end
    end
    if audioAcc >= 1 then
        audioAcc = 0
        if music.IsPlaying and isOpen and music.TimeLength > 0 and nowLbl then
            nowLbl:Set(string.format("Играет: %s / %s", fmt(music.TimePosition), fmt(music.TimeLength)))
        end
    end
end)

