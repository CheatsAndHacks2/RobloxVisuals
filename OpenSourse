local function fetch(url)
    if req then
        local ok, res = pcall(req, { Url = url, Method = "GET" })
        if ok and res and res.Body and ((res.StatusCode or 200) < 300) then return true, res.Body end
    end
    local ok, b = pcall(function() return game:HttpGet(url) end)
    if ok and b then return true, b end
    return false
end
