local tags, friends = {}, {}
local function clearTag(p) local o = tags[p] if o then for _, i in pairs(o) do pcall(function() i:Destroy() end) end tags[p] = nil end end
local function hidePlayer(p)
    if p == lp or not p.Character then return end
    if opt.pl_hide then
        for _, d in ipairs(p.Character:GetDescendants()) do
            if d:IsA("BasePart") or d:IsA("Decal") then apply("hide", d, "Transparency", 1) end
        end
    end
end
local function buildTag(p)
    clearTag(p)
    if p == lp or not p.Character then return end
    local ch = p.Character
    local head = ch:FindFirstChild("Head")
    local o = {} tags[p] = o
    if opt.pl_hl then
        local h = Instance.new("Highlight") h.Name = "DH_HL" h.Adornee = ch h.DepthMode = Enum.HighlightDepthMode.Occluded
        h.FillTransparency = opt.pl_hl_t / 100 h.OutlineTransparency = 0 h.Parent = cam() o.hl = h
    end
    if (opt.pl_names or opt.pl_dist or opt.pl_hp) and head then
        local b = Instance.new("BillboardGui") b.Name = "DH_Tag" b.Adornee = head b.Size = UDim2.fromOffset(170, 46) b.StudsOffset = Vector3.new(0, 2.6, 0)
        b.AlwaysOnTop = false b.MaxDistance = opt.pl_maxd b.Parent = cam()
        local t = Instance.new("TextLabel") t.Name = "T" t.Size = UDim2.new(1, 0, 0, 20) t.BackgroundTransparency = 1 t.TextColor3 = Color3.new(1, 1, 1)
        t.TextStrokeTransparency = .4 t.Font = Enum.Font.GothamBold t.TextSize = 14 t.Parent = b
        local d = t:Clone() d.Name = "D" d.Position = UDim2.fromOffset(0, 19) d.Font = Enum.Font.Gotham d.TextSize = 12 d.Parent = b
        local bar = Instance.new("Frame") bar.Name = "Bar" bar.Size = UDim2.new(.6, 0, 0, 4) bar.Position = UDim2.new(.2, 0, 0, 38) bar.BackgroundColor3 = Color3.new(0, 0, 0)
        bar.BackgroundTransparency = .4 bar.BorderSizePixel = 0 bar.Visible = opt.pl_hp bar.Parent = b
        local fl = Instance.new("Frame") fl.Name = "F" fl.Size = UDim2.fromScale(1, 1) fl.BackgroundColor3 = Color3.fromRGB(48, 209, 88) fl.BorderSizePixel = 0 fl.Parent = bar
        o.tag = b
    end
    hidePlayer(p)
end
local function refreshTags()
    if not opt.pl_hide then revert("hide") end
    for _, p in ipairs(players:GetPlayers()) do buildTag(p) end
end
local function updateTags()
    local me = hrp()
    for p, o in pairs(tags) do
        local ch = p.Character
        local col = theme.accent
        if opt.pl_team and p.Team then col = p.TeamColor.Color end
        if friends[p] and opt.pl_friend then col = Color3.fromRGB(48, 209, 88) end
        if o.hl then o.hl.FillColor = col o.hl.OutlineColor = col end
        if o.tag and ch then
            local h = ch:FindFirstChildOfClass("Humanoid")
            local r = ch:FindFirstChild("HumanoidRootPart")
            o.tag.T.Text = opt.pl_names and p.DisplayName or ""
            o.tag.T.TextColor3 = col
            o.tag.D.Text = (opt.pl_dist and me and r) and (math.floor((me.Position - r.Position).Magnitude) .. " м") or ""
            if h and opt.pl_hp then o.tag.Bar.F.Size = UDim2.fromScale(math.clamp(h.Health / math.max(h.MaxHealth, 1), 0, 1), 1) end
        end
    end
end
local function watchPlayer(p)
    task.spawn(function()
        local ok, r = pcall(function() return lp:IsFriendsWith(p.UserId) end)
        friends[p] = ok and r
    end)
    p.CharacterAdded:Connect(function() task.wait(1) buildTag(p) end)
    if p.Character then buildTag(p) end
end

