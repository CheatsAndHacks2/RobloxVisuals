local function loadVideo(src)
    src = (src or ""):gsub("^%s+", ""):gsub("%s+$", "")
    if src == "" then return end
    if src:match("^%d+$") or src:match("^rbxassetid://") then
        vframe.Video = src:match("^%d+$") and ("rbxassetid://" .. src) or src
        vframe.Playing = true vwin.Visible = true return
    end
    if src:match("^https?://") then
        if isWebService(src) then
            notify("Видео", "Сайты нельзя встроить в Roblox — нужен прямой .webm. Открываю в браузере.", 5) openWeb(src) return
        end
        if src:lower():find("%.mp4", 1, true) then notify("Видео", "Roblox не играет mp4. Нужен .webm", 5) end
        if not (writefile and getasset) then notify("Видео", "Экзекутор не поддерживает writefile/getcustomasset", 5) return end
        notify("Видео", "Загрузка…", 2)
        task.spawn(function()
            local ok, body = fetch(src)
            if not ok then notify("Видео", "Не удалось скачать файл", 4) return end
            ensureCache()
            local path = CACHE .. "/v_" .. hash(src) .. ".webm"
            if not pcall(writefile, path, body) then notify("Видео", "Ошибка записи файла", 4) return end
            local ok2, a = pcall(getasset, path)
            if ok2 then vframe.Video = a vframe.Playing = true vwin.Visible = true notify("Видео", "Играет", 2) else notify("Видео", "Ошибка getcustomasset", 4) end
        end)
    end
end

local music = mk("Sound", { Name = "DH_Music", Volume = 1, Parent = sound })
local eq = mk("EqualizerSoundEffect", { Name = "DH_EQ", Parent = music })
local nowLbl
local function playAudio(src)
    src = (src or ""):gsub("^%s+", ""):gsub("%s+$", "")
    if src == "" then return end
    if src:match("^%d+$") then music.SoundId = "rbxassetid://" .. src
    elseif src:match("^rbxassetid://") then music.SoundId = src
    elseif src:match("^https?://") then
        if isWebService(src) then notify("Музыка", "Сервис нельзя проиграть напрямую — открываю в браузере", 5) openWeb(src) return end
        if not (writefile and getasset) then notify("Музыка", "Экзекутор не поддерживает writefile/getcustomasset", 5) return end
        local ok, body = fetch(src)
        if not ok then notify("Музыка", "Не удалось скачать", 4) return end
        ensureCache()
        local ext = "mp3"
        local low = src:lower()
        for _, e in ipairs({ "ogg", "wav", "flac", "mp3" }) do
            if low:find("." .. e, 1, true) then ext = e break end
        end
        local path = CACHE .. "/a_" .. hash(src) .. "." .. ext
        if not pcall(writefile, path, body) then notify("Музыка", "Ошибка записи", 4) return end
        local ok2, a = pcall(getasset, path)
        if not ok2 then notify("Музыка", "Ошибка getcustomasset", 4) return end
        music.SoundId = a
    else return end
    music:Play()
    if nowLbl then nowLbl:Set("Сейчас: " .. src:sub(1, 50)) end
end

